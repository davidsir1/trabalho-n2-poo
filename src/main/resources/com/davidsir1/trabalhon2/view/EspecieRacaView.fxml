<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" spacing="16.0" styleClass="fundo-tela" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidsir1.trabalhon2.controller.view.EspecieRacaController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Cadastro de Especies e Raças">
         <styleClass>
            <String fx:value="title-2" />
            <String fx:value="text-bold" />
         </styleClass>
      </Label>
      <HBox prefWidth="200.0" spacing="12.0">
         <children>
            <VBox spacing="12.0">
               <children>
                  <Button fx:id="btnAdicionarEspecie" mnemonicParsing="false" onAction="#adicionarEspecie" prefWidth="170.0" styleClass="accent" text="Adicionar Especie" />
                  <Button fx:id="btnEditarEspecie" mnemonicParsing="false" onAction="#editarEspecie" prefWidth="170.0" styleClass="button-outlined" text="Editar Especie" />
                  <Button fx:id="btnExcluirEspecie" mnemonicParsing="false" prefWidth="170.0" styleClass="danger" text="Excluir Especie" />
               </children>
            </VBox>
            <VBox spacing="12.0">
               <children>
                  <Button fx:id="btnAdicionarRaca" mnemonicParsing="false" onAction="#adicionarRaca" prefWidth="170.0" styleClass="accent" text="Adicionar Raça" />
                  <Button fx:id="btnEditarRaca" mnemonicParsing="false" onAction="#editarRaca" prefWidth="170.0" styleClass="button-outlined" text="Editar Raça" />
                  <Button fx:id="btnExcluirRaca" mnemonicParsing="false" prefWidth="170.0" styleClass="danger" text="Excluir Raça" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="16.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="text-bold" text="Lista de Especies" />
                  <TableView fx:id="tabelaEspecies" prefHeight="200.0" prefWidth="200.0" styleClass="striped" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn prefWidth="70.0" text="ID" />
                      <TableColumn prefWidth="200.0" text="Especie" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="16.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="text-bold" text="Lista de Raças" />
                  <TableView fx:id="tabelaRacas" prefHeight="200.0" prefWidth="200.0" styleClass="striped" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn prefWidth="75.0" text="ID" />
                        <TableColumn prefWidth="180.0" text="Raça" />
                      <TableColumn prefWidth="200.0" text="Especie Pertencente" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
